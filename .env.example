# API environment (copy to .env)

# MongoDB
MONGODB_URI=mongodb://localhost:27017/betterorder

# JWT
JWT_SECRET=change-me

# SMTP (Ionos)
SMTP_HOST=smtp.ionos.com
SMTP_USER=hallo@betterorder.de
SMTP_PASS=
SMTP_PORT=587
SMTP_SECURE=true
SMTP_FROM=hallo@betterorder.de
SMTP_FROM_NAME=BetterOrder
SUPPORT_EMAIL=hallo@betterorder.de

# Email platform
EMAIL_ENABLED=true
EMAIL_PREVIEW_MODE=false
EMAIL_LOG_RETENTION_DAYS=90

# URLs
CUSTOMER_APP_URL=http://localhost:4003
ADMIN_APP_URL=http://localhost:3000
APP_USER_EMAIL_VERIFICATION_URL=http://localhost:4003/verify-email
APP_USER_PASSWORD_RESET_URL=http://localhost:4003/reset-password

# Google auth (storefront ID token verification)
GOOGLE_CLIENT_ID=

# Redis (optional, SSE fan-out)
REDIS_ENABLED=false
REDIS_URL=
